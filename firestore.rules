rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isValidQuestion() {
      let data = request.resource.data;
      return data.keys().hasOnly(['category', 'questionText', 'description', 'difficulty', 'topics', 'followUpQuestions', 'source', 'originalCategory', 'importedAt', 'createdAt', 'updatedAt'])
        && data.keys().hasAll(['category', 'questionText', 'description', 'difficulty', 'topics', 'createdAt', 'updatedAt'])
        && data.category in ['ethical', 'critical_thinking', 'problem_solving', 'communication', 'policy', 'personal']
        && data.difficulty in ['easy', 'medium', 'hard']
        && data.questionText is string && data.questionText.size() >= 1 && data.questionText.size() <= 2000
        && data.description is string && data.description.size() <= 2000
        && data.topics is list && data.topics.size() <= 10
        && data.get('followUpQuestions', []) is list && data.get('followUpQuestions', []).size() <= 20
        && data.get('source', 'manual') in ['manual', 'pdf_import']
        && data.get('originalCategory', '') is string && data.get('originalCategory', '').size() <= 200
        && data.updatedAt == request.time;
    }

    function keepsImportDetails() {
      let before = resource.data;
      let after = request.resource.data;
      return after.get('source', 'manual') == before.get('source', 'manual')
        && after.get('originalCategory', '') == before.get('originalCategory', '')
        && after.get('importedAt', null) == before.get('importedAt', null);
    }

    match /users/{uid}/questions/{questionId} {
      allow get, list, delete: if isOwner(uid);
      allow create: if isOwner(uid) && isValidQuestion() && request.resource.data.createdAt == request.time
        && request.resource.data.get('importedAt', request.time) == request.time;
      allow update: if isOwner(uid) && isValidQuestion() && request.resource.data.createdAt == resource.data.createdAt
        && keepsImportDetails();
    }
  }
}
